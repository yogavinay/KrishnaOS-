# MAHABHARATA SYSTEM - Environment Variables
# Copy this to .env and fill in your values

# Ollama (local LLM - install from ollama.com)
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434/v1

# Edge-TTS (free Microsoft voices - no API key needed)
TTS_VOICE=en-US-GuyNeural
TTS_ENABLED=true

# Tavily Search (free tier: tavily.com)
TAVILY_API_KEY=your-tavily-key-here

# PostgreSQL (falls back to SQLite if unavailable)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mahabharata

# Whisper STT
WHISPER_MODEL=base

# System
USER_NAME=YourName
WAKE_WORD=krishna
DEBUG=false

# Integrations (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GITHUB_TOKEN=
